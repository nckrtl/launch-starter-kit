{
    "_metadata": {
        "major_version": 1,
        "minor_version": 1
    },
    "display_information": {
        "name": "Commander",
        "description": "Project notifications from Commander",
        "background_color": "#000000"
    },
    "features": {
        "bot_user": {
            "display_name": "commander-app",
            "always_online": false
        }
    },
    "oauth_config": {
        "scopes": {
            "bot": ["channels:read", "chat:write", "chat:write.public"]
        }
    },
    "settings": {
        "is_mcp_enabled": false,
        "org_deploy_enabled": false,
        "socket_mode_enabled": false,
        "token_rotation_enabled": false
    }
}
