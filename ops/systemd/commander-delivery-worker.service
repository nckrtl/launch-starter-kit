[Unit]
Description=Commander delivery queue worker
Wants=network-online.target
After=network-online.target herdr-orbit.service

[Service]
Type=simple
WorkingDirectory=/fast/apps/commander
ExecStart=/usr/bin/php /fast/apps/commander/artisan queue:work database --name=commander-delivery --queue=default --sleep=1 --rest=1 --tries=0 --timeout=540 --max-time=3600 --memory=256 --no-interaction
ExecReload=/usr/bin/php /fast/apps/commander/artisan queue:restart
Restart=always
RestartSec=5
TimeoutStopSec=600
KillMode=mixed

[Install]
WantedBy=default.target
